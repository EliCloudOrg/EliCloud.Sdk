<Project>

  <!-- 全解决方案共用的编译设置。目标框架固定 net10.0（用户要求）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      环境类的 NuGet 警告不应当作编译错误（它们与代码质量无关）：
        NU1507 —— 本机全局配置里有多个包源（nuget.org / Azure DevOps / 离线目录），
                  CPM 会提示做包源映射，属于机器配置而非常仓库问题；
        NU1900~NU1904 —— 源不可达时拿不到包审核/漏洞数据。
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1507;NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- NU1507 每次生成都会重复刷屏，直接静音；包源映射由使用者按自己的环境决定。 -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 文档注释缺失只是噪音，不当错误：SDK 的公开 API 必须逐个写注释，但先允许渐进补齐。 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!-- 可复现构建：不隐式引入 SDK 自带的分析器等额外依赖 -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>EliCloud SDK</Product>
    <Authors>EliCloud</Authors>
    <Company>EliCloud</Company>
    <Copyright>Copyright (c) 2026 EliCloud</Copyright>
    <VersionPrefix>1.0.0</VersionPrefix>
    <!--
      预发布通道：nuget.org 上同一版本号**不可覆盖**，只能 unlist，所以每次发布都要换版本号。
      发正式版 = 删掉（或注释掉）下面这行；临时换号用 `dotnet pack -p:VersionSuffix=beta.1`
      （命令行属性优先于本行）。
    -->
    <VersionSuffix>alpha.2</VersionSuffix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- 产物集中到 artifacts/packages，推包脚本照着这个目录找，不猜 bin/ 路径。 -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
    <!--
      仓库地址不写死：在 git 仓库里构建时由 SDK 的 git 目标从 origin 推导
      （EliCloudOrg/EliCloud.Sdk），离开 git 仓库时自然为空。
      PublishRepositoryUrl 决定这个地址是否写进包元数据（nuspec 的 <repository url>）
      与程序集的 AssemblyMetadata；缺省 false 时 nuspec 里只剩 type 和 commit。
      SourceLink（PDB 里的源码地址映射）则由 SDK 内置支持自动生成，无需额外包。
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
